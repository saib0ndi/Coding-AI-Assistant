# MCP HTTP API (tools: /tools/agent_execute, /tools/index_codebase, …)
MCP_SERVER_PORT=3078
# Set MCP_PORT_AUTO_INCREMENT=true only if you want 3079, 3080, … when 3078 is busy
MCP_PORT_AUTO_INCREMENT=
HTTP_REQUEST_TIMEOUT_MS=300000
OLLAMA_HOST=http://127.0.0.1:11434

# Recommended split (models must exist on your Ollama host — ollama list)
OLLAMA_MODEL=llama3.3:70b-instruct-q4_K_M
OLLAMA_CODE_MODEL=qwen2.5:32b-instruct-q4_K_M
OLLAMA_TEST_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_AUTONOMOUS_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_FAST_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_PROJECT_MODEL=qwen2.5:14b-instruct-q4_K_M

# Per-agent Ollama instances (host/model/timeout). Unset = use OLLAMA_HOST / OLLAMA_MODEL above.
# Point agents at different GPUs/servers, e.g. code on :11434, test on :11435.
# OLLAMA_ORCHESTRATOR_HOST=   OLLAMA_ORCHESTRATOR_MODEL=   OLLAMA_ORCHESTRATOR_TIMEOUT_MS=
# OLLAMA_CODE_HOST=           OLLAMA_CODE_MODEL=           OLLAMA_CODE_TIMEOUT_MS=
# OLLAMA_TEST_HOST=           OLLAMA_TEST_MODEL=           OLLAMA_TEST_TIMEOUT_MS=
# OLLAMA_PROJECT_HOST=        OLLAMA_PROJECT_MODEL=        OLLAMA_PROJECT_TIMEOUT_MS=
# OLLAMA_AUTONOMOUS_HOST=     OLLAMA_AUTONOMOUS_MODEL=     OLLAMA_AUTONOMOUS_TIMEOUT_MS=
# Shorthand model envs (used when OLLAMA_<ROLE>_MODEL is unset) — see recommended split above.

# Autonomous self-correction: max strategy-level re-plans per task. When a
# critical step exhausts param-level retries, the agent re-plans the remaining
# work with a different approach instead of failing. Set to 0 to disable.
AUTONOMOUS_MAX_REPLANS=2

# Cross-task learning: where finished-task outcomes (plans, successes, failures)
# are persisted so similar future tasks can be primed with past lessons.
# Defaults to logs/task-memory.json.
# TASK_MEMORY_PATH=logs/task-memory.json

# --- Sandboxing / command execution safety ---------------------------------
# App-level run mode for FileSystemTool:
#   full       - all file ops and commands allowed (default; local dev)
#   restricted - reads only; writes denied; commands must be allowlisted and
#                inline interpreter escapes (node -e / python -c) are blocked
#   read-only  - reads only; no writes, no command execution
# MCP_OLLAMA_RUN_MODE=full
# Per-command limits (defaults: 120s timeout, ~10MB output cap)
# MCP_OLLAMA_CMD_TIMEOUT_MS=120000
# MCP_OLLAMA_CMD_MAX_OUTPUT=10000000
# Opt-in OS-level sandbox for spawned commands (Linux bwrap/firejail, macOS
# sandbox-exec): confines filesystem to the workspace and blocks network.
# MCP_OLLAMA_OS_SANDBOX=1
# Allow network inside the OS sandbox (default: blocked)
# MCP_OLLAMA_SANDBOX_NET=0
PORT=8080
NODE_ENV=production

# Docker Configuration
DOCKER_SERVER_URL=http://localhost:15267
DOCKER_EXPOSED_PORT=15267
DOCKER_INTERNAL_PORT=8080

# Extension Configuration
VSCODE_MCP_SERVER_URL=http://localhost:15267

# Security: comma-separated list of hosts the Ollama provider is allowed to connect to
# Add your Ollama server IP here instead of hardcoding it in source code
OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional: bearer token for secured Ollama endpoints
OLLAMA_AUTH_TOKEN=

# Phase 2: codebase semantic index (Ollama /api/embed)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT_MS=60000
# Optional: dedicated Ollama host for embeddings only. Point this at an instance
# on a free GPU so embeddings don't silently fall back to degraded hash vectors
# when the main OLLAMA_HOST is busy/OOM. Defaults to OLLAMA_HOST when unset.
# OLLAMA_EMBED_HOST=http://127.0.0.1:11533

# Security: comma-separated list of origins allowed for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3078,http://localhost:8080

# Cloud API (OpenAI-compatible — works with Nvidia NIM, OpenAI, etc.)
# When set, the server routes chat requests to the cloud API instead of local Ollama.
# The VS Code extension can also store the key in its secrets store (preferred for local dev),
# but setting it here means the key never leaves the server — useful for shared/Docker deployments.
# CLOUD_API_KEY=nvapi-xxxx
# CLOUD_BASE_URL=https://integrate.api.nvidia.com/v1
# CLOUD_MODEL=nvidia/nemotron-4-340b-instruct

# Web Search API Keys (Optional - Fallback is DuckDuckGo zero-config search)
# TAVILY_API_KEY=tvly-xxxx
# BRAVE_API_KEY=brave-xxxx
# GOOGLE_SEARCH_API_KEY=google-xxxx
# GOOGLE_CX=google-cx-xxxx
