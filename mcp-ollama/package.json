{
  "type": "module",
  "name": "mcp-ollama-server-enhanced",
  "version": "2.0.0",
  "description": "Enhanced MCP server with auto error fixing capabilities using Ollama",
  "main": "dist/index.js",
  "bin": {
    "mcp-ollama-enhanced": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist",
    "update": "npm update && npm audit fix",
    "install-extension": "./update-install.sh",
    "full-install": "npm run update && npm run build && cd vscode-extension && npm run update && npm run build && npm run package"
  },
  "keywords": [
    "mcp",
    "ollama",
    "ai",
    "code-completion",
    "error-fixing",
    "debugging",
    "language-server",
    "team-collaboration",
    "multi-model",
    "analytics",
    "rest-api"
  ],
  "author": "SAI BONDI",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.13",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "tsx": "^4.20.5",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
