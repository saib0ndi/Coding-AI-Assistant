{
  "name": "mcp-ollama",
  "version": "2.0.0",
  "description": "MCP server for Ollama with enhanced conversation context and 12 AI tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-ollama": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npx tsc -p tsconfig.test.json && node --test dist/**/*.test.js && node tests/smokeTest.mjs",
    "start": "node dist/index.js",
    "dev": "concurrently --kill-others --names \"tsc,server\" --prefix-colors \"cyan,green\" \"tsc --watch --preserveWatchOutput\" \"nodemon --config nodemon.json\"",
    "prepublishOnly": "npm run build",
    "build:weather-app": "tsc --project packages/weather-app/tsconfig.json",
    "start:weather-app": "ts-node packages/weather-app.ts"
  },
  "keywords": [
    "mcp",
    "ollama",
    "ai",
    "llm",
    "code-completion",
    "conversation-context"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@types/express": "^5.0.5",
    "@types/node-fetch": "^2.6.13",
    "compromise": "^14.14.4",
    "express": "^5.1.0",
    "natural": "^6.12.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3"
  }
}
