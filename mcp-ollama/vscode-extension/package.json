{
  "name": "smartcode-aiassist",
  "displayName": "SmartCode AI Assistant - Local AI Coding Agent",
  "description": "Professional AI coding assistant with /dev, /test, /review agent commands. 100% local, private, and free.",
  "version": "3.3.1",
  "publisher": "saibondi",
  "author": {
    "name": "SmartCode Team"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smartcode/ai-assistant"
  },
  "homepage": "https://github.com/smartcode/ai-assistant",
  "bugs": {
    "url": "https://github.com/smartcode/ai-assistant/issues"
  },
  "keywords": [
    "ai",
    "assistant",
    "coding",
    "copilot",
    "ollama",
    "local-ai",
    "code-generation",
    "testing",
    "review",
    "documentation",
    "mcp",
    "agent",
    "workflow",
    "diff-viewer",
    "security-scan"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/AI-Coding%20Agent-blue",
      "href": "https://github.com/smartcode/ai-assistant",
      "description": "Professional AI Coding Agent"
    },
    {
      "url": "https://img.shields.io/badge/100%25-Local%20%26%20Private-green",
      "href": "https://github.com/smartcode/ai-assistant",
      "description": "100% Local & Private"
    },
    {
      "url": "https://img.shields.io/badge/Cost-$0%20Forever-brightgreen",
      "href": "https://github.com/smartcode/ai-assistant",
      "description": "Free Forever"
    }
  ],
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Snippets",
    "Testing",
    "Linters",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "smartcode.workflow",
          "name": "🤖 Agent Workflow",
          "when": "smartcode.workflowActive"
        },
        {
          "id": "smartcode.issues",
          "name": "🔍 Code Issues",
          "when": "smartcode.hasIssues"
        },
        {
          "id": "smartcode.progress",
          "name": "📊 Task Progress",
          "when": "smartcode.taskRunning"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "smartcode-aiassist",
        "name": "smartcode-ai-assistant",
        "description": "AI-powered coding assistant with MCP-Ollama backend",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Fix code issues"
          },
          {
            "name": "explain",
            "description": "Explain code"
          },
          {
            "name": "tests",
            "description": "Generate tests"
          }
        ]
      }
    ],
    "configuration": {
      "title": "SmartCode AI Assistant",
      "properties": {
        "mcp-ollama.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SmartCode AI Assistant with professional agent commands (/dev, /test, /review)"
        },
        "mcp-ollama.host": {
          "type": "string",
          "default": "http://10.10.110.25:11434",
          "description": "Ollama server host"
        },
        "mcp-ollama.ollamaHost": {
          "type": "string",
          "default": "http://10.10.110.25:11434",
          "description": "Ollama server host URL"
        },
        "mcp-ollama.serverHost": {
          "type": "string",
          "default": "localhost",
          "description": "MCP server hostname"
        },
        "mcp-ollama.serverPort": {
          "type": "number",
          "default": 3077,
          "description": "MCP server port"
        },
        "mcp-ollama.allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "localhost",
            "127.0.0.1",
            "::1"
          ],
          "description": "List of allowed server hostnames"
        },
        "mcp-ollama.allowSelfSignedCerts": {
          "type": "boolean",
          "default": true,
          "description": "Allow self-signed certificates for development"
        },
        "mcp-ollama.serverUrl": {
          "type": "string",
          "default": "http://localhost:3077",
          "description": "MCP server URL"
        },
        "mcp-ollama.serverPath": {
          "type": "string",
          "default": "http://localhost:3077",
          "description": "MCP server path"
        },
        "mcp-ollama.model": {
          "type": "string",
          "default": "deepseek-coder-v2:236b",
          "description": "Default Ollama model for AI assistance (supports 39+ models)",
          "enum": [
            "deepseek-coder-v2:236b",
            "deepseek-r1:70b",
            "llama3.3:70b",
            "phi4:latest",
            "qwen3:32b",
            "llama3.1:8b",
            "gemma3:27b"
          ]
        },
        "mcp-ollama.useHttps": {
          "type": "boolean",
          "default": true,
          "description": "Use HTTPS for secure connections"
        },
        "mcp-ollama.suggestionDelay": {
          "type": "number",
          "default": 500,
          "description": "Delay before showing suggestions (ms)"
        },
        "mcp-ollama.maxSuggestions": {
          "type": "number",
          "default": 3,
          "description": "Maximum number of suggestions"
        },
        "mcp-ollama.enableAgentCommands": {
          "type": "boolean",
          "default": true,
          "description": "Enable professional agent commands (/dev, /test, /review, /docs)"
        },
        "mcp-ollama.showWorkflowProgress": {
          "type": "boolean",
          "default": true,
          "description": "Show real-time workflow progress visualization"
        },
        "mcp-ollama.enableDiffViewer": {
          "type": "boolean",
          "default": true,
          "description": "Enable side-by-side code diff viewer with accept/reject"
        },
        "mcp-ollama.enableIssuesPanel": {
          "type": "boolean",
          "default": true,
          "description": "Enable security and quality issues detection panel"
        }
      }
    },
    "commands": [
      {
        "command": "mcp-ollama.explain",
        "title": "🔍 Explain Code",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.fix",
        "title": "🔧 Fix Code Issues",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.tests",
        "title": "🧪 Generate Tests",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.docs",
        "title": "📝 Generate Documentation",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.showChatPanel",
        "title": "💬 Open AI Chat",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.generateFunction",
        "title": "⚡ Generate Function",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.generateClass",
        "title": "🏗️ Generate Class",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.openLabs",
        "title": "🧪 Open Copilot Labs",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.optimizeCode",
        "title": "⚡ Optimize Performance",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.securityScan",
        "title": "🔒 Security Scan",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.translateCode",
        "title": "🔄 Translate Language",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.codeReview",
        "title": "👀 Code Review",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.enable",
        "title": "Enable SmartCode-AIAssist"
      },
      {
        "command": "mcp-ollama.disable",
        "title": "Disable SmartCode-AIAssist"
      },
      {
        "command": "mcp-ollama.showStats",
        "title": "Show Usage Statistics"
      },
      {
        "command": "mcp-ollama.logAcceptance",
        "title": "Log Suggestion Acceptance"
      },
      {
        "command": "mcp-ollama.analyzeAST",
        "title": "Analyze Code Structure"
      },
      {
        "command": "mcp-ollama.exportHistory",
        "title": "Export Chat History"
      },
      {
        "command": "mcp-ollama.importHistory",
        "title": "Import Chat History"
      },
      {
        "command": "mcp-ollama.toggleAgentMode",
        "title": "🤖 Toggle Agent Mode"
      },
      {
        "command": "mcp-ollama.executeAgentTask",
        "title": "🚀 Execute Agent Task"
      },
      {
        "command": "mcp-ollama.startServer",
        "title": "🔧 Start MCP Server"
      },
      {
        "command": "mcp-ollama.showWorkflowProgress",
        "title": "📊 Show Workflow Progress",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.showCodeDiff",
        "title": "🔍 Show Code Changes",
        "category": "SmartCode"
      },
      {
        "command": "mcp-ollama.showIssuesPanel",
        "title": "🚨 Show Code Issues",
        "category": "SmartCode"
      }
    ],
    "keybindings": [
      {
        "command": "mcp-ollama.showChatPanel",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus"
      },
      {
        "command": "mcp-ollama.explain",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      },
      {
        "command": "mcp-ollama.nextSuggestion",
        "key": "alt+]",
        "when": "editorTextFocus"
      },
      {
        "command": "mcp-ollama.previousSuggestion",
        "key": "alt+[",
        "when": "editorTextFocus"
      },
      {
        "command": "mcp-ollama.alternatives",
        "key": "ctrl+enter",
        "when": "editorTextFocus"
      },
      {
        "command": "mcp-ollama.acceptSuggestion",
        "key": "tab",
        "when": "editorTextFocus && mcp-ollama.suggestionVisible"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mcp-ollama.explain",
          "when": "editorHasSelection",
          "group": "1_copilot@1"
        },
        {
          "command": "mcp-ollama.fix",
          "when": "editorHasSelection",
          "group": "1_copilot@2"
        },
        {
          "command": "mcp-ollama.tests",
          "when": "editorHasSelection",
          "group": "1_copilot@3"
        },
        {
          "command": "mcp-ollama.docs",
          "when": "editorHasSelection",
          "group": "1_copilot@4"
        },
        {
          "command": "mcp-ollama.optimizeCode",
          "when": "editorHasSelection",
          "group": "1_copilot@5"
        },
        {
          "command": "mcp-ollama.securityScan",
          "when": "editorHasSelection",
          "group": "1_copilot@6"
        },
        {
          "command": "mcp-ollama.codeReview",
          "when": "editorHasSelection",
          "group": "1_copilot@7"
        },
        {
          "command": "mcp-ollama.translateCode",
          "when": "editorHasSelection",
          "group": "1_copilot@8"
        },
        {
          "submenu": "smartcode.generate",
          "group": "2_generate@1"
        },
        {
          "command": "mcp-ollama.showChatPanel",
          "group": "3_chat@1"
        },
        {
          "command": "mcp-ollama.openLabs",
          "group": "3_chat@2"
        }
      ],
      "smartcode.generate": [
        {
          "command": "mcp-ollama.generateFunction",
          "group": "generate@1"
        },
        {
          "command": "mcp-ollama.generateClass",
          "group": "generate@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "smartcode.generate",
        "label": "🚀 Generate Code"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "package": "npx vsce package --out smartcode-aiassist-3.1.1.vsix --allow-missing-repository",
    "update": "npm update && npm audit fix",
    "clean": "rm -rf out",
    "install-local": "code --install-extension smartcode-aiassist-2.9.2.vsix --force"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.13",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "@types/node-fetch": "^2.6.11",
    "node-fetch": "^2.7.0"
  },
  "overrides": {
    "undici": "^5.28.4"
  }
}
