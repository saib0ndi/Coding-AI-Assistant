{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "outDir": "out",
        "lib": ["ES2022"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "moduleResolution": "node16",
        "types": ["node", "vscode"],
        "ignoreDeprecations": "5.0",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true
    },
    "exclude": ["node_modules", ".vscode-test", "src/test"]
}
